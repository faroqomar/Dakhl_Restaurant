{
  "name": "daftar-restaurant",
  "productName": "Daftar",
  "version": "1.4.0",
  "description": "Local restaurant expense and cash tracker",
  "main": "app/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "electron-packager . Daftar --platform=darwin --arch=arm64 --out=dist --overwrite --asar --app-bundle-id=com.eros.daftar --app-category-type=public.app-category.finance --icon=assets/Daftar.icns --ignore=^/design --ignore=^/tests --ignore=^/README --ignore=^/.impeccable --ignore=^/scripts"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.5.1",
    "jsdom": "^30.1.2"
  }
}
