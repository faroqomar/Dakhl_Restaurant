    {
      "id": "8d7c5438-085d-463d-84c0-33b46e8213b2",
      "text": "`NativeFileTransfer` is a configurable native file byte-transfer adapter selected through `madar_application` contracts. It accepts a positive `maxBytes`, filename, MIME type, and allowed extensions; bounds reported size, cumulative Dart stream reads, and accepted or exported payloads; and leaves schema and import-policy validation to consumer applications. Native saving reports only a native handoff and does not guarantee native memory or disk limits, atomic replacement, or rollback at an existing external destination. Cancelled and failed operations remain retryable.",
      "type": "observation",
      "entities": [
        "consumer applications",
        "madar_application",
        "NativeFileTransfer",
        "native file saving"
      ],
      "context": null,
      "occurred_start": null,
      "occurred_end": null,
