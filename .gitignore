/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local engine worktree wiring; canonical sibling paths live in pubspec.yaml.
pubspec_overrides.yaml

# Local native Penpot archives: retained on disk; receipts/hashes stay reviewable.
# Avoid repeatedly ingesting large recovery bundles into Git snapshots.
/outputs/penpot/**/*.penpot
/outputs/penpot/completion/

# Reproducible local C1 visual review captures; retain compact receipts.
/outputs/completion-review/c1-visual/

# Generated native acceptance binaries remain local; retain exact receipts.
/outputs/completion-review/**/*.app/
/outputs/preflight-fixtures/**/*.apk
